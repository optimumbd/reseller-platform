# Root .htaccess — for shared hosts that won't let you change docroot to /public.
# Forwards every request to public/ while hiding it from the URL.
<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    # If the requested path is not /public/<something>, rewrite into /public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block direct access to anything outside public/
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(composer\.(json|lock)|package\.json|package-lock\.json|\.env.*|\.git.*|README\.md|CHANGELOG\.md|LICENSE)$">
    Require all denied
</FilesMatch>
