APP_NAME="Reseller Platform"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=
APP_LOCALE=en
APP_TIMEZONE=Asia/Dhaka

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reseller
DB_USER=root
DB_PASS=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=database

MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Reseller Platform"

CURRENCY_DEFAULT=USD
CURRENCY_FX_PROVIDER=exchangerate.host

CAPTCHA_DRIVER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Default registrar driver: mock (no real API), namecheap, spaceship, cloudflare
REGISTRAR_DRIVER=mock
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX=true

SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Payment gateways
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_SANDBOX=true

# Pay KureGhor (https://paykureghor.com)
PAYKUREGHOR_API_KEY=
PAYKUREGHOR_SECRET_KEY=
PAYKUREGHOR_BRAND_KEY=
PAYKUREGHOR_BASE_URL=

# RokoPay (https://rokopay.com) — same API surface as Pay KureGhor, host: https://pay.rokopay.com
ROKOPAY_API_KEY=
ROKOPAY_SECRET_KEY=
ROKOPAY_BRAND_KEY=
ROKOPAY_BASE_URL=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

SMS_DRIVER=
SMS_API_KEY=
SMS_SENDER=

# Social Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Observability (optional)
SENTRY_DSN=
DATADOG_API_KEY=

# Storage
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_KEY=
S3_SECRET=
S3_ENDPOINT=

# Maintenance / feature flags
MAINTENANCE_MODE=false
INSTALL_LOCK=false
